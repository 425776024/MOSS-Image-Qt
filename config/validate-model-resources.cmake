# Validate before Qt embeds these bytes, even when release tests are disabled.
function(moss_validate_model_resources catalog)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${catalog}")
    file(READ "${catalog}" catalog_json)
    string(JSON count LENGTH "${catalog_json}" files)
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
        string(JSON resource ERROR_VARIABLE resource_error GET "${catalog_json}" files ${index} resource)
        if(resource_error)
            continue()
        endif()
        string(REGEX REPLACE "^:/models/" "" relative "${resource}")
        set(path "${CMAKE_CURRENT_SOURCE_DIR}/${relative}")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")
        if(NOT EXISTS "${path}")
            message(FATAL_ERROR "Missing pinned embedded model resource: ${relative}")
        endif()
        string(JSON expected_bytes GET "${catalog_json}" files ${index} bytes)
        string(JSON expected_sha GET "${catalog_json}" files ${index} sha256)
        file(SIZE "${path}" actual_bytes)
        file(SHA256 "${path}" actual_sha)
        if(NOT actual_bytes EQUAL expected_bytes OR NOT actual_sha STREQUAL expected_sha)
            message(FATAL_ERROR
                "Embedded model resource does not match its pinned size/SHA-256: ${relative}. "
                "Restore the catalogued file with LF line endings before building; "
                "Git for Windows CRLF conversion corrupts these byte-pinned resources.")
        endif()
    endforeach()
endfunction()

moss_validate_model_resources("${CMAKE_CURRENT_SOURCE_DIR}/config/models.json")
if(MOSS_APP_STORE)
    moss_validate_model_resources("${CMAKE_CURRENT_SOURCE_DIR}/config/models-store.json")
endif()
